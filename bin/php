#!/bin/bash

if [ -t 0 ] ; then
    moinsit='-it'
else
    moinsit=''
fi

docker run \
    --init \
    --rm \
    $moinsit \
    --name php-ddd-event-running-script \
    -v "$(pwd)/bin/docker/php/php.ini:/usr/local/etc/php/php.ini" \
    -v "$PWD":"$PWD" \
    --user 1000:1000 \
    -w "$PWD" \
    php-ddd-event php $@
